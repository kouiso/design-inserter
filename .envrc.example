# direnv 用の環境変数テンプレート
# 使い方:
#   1. このファイルを .envrc にコピー（cp .envrc.example .envrc）
#   2. 各値を実際のトークン/パスワードに書き換え
#   3. `direnv allow` を実行
#
# .envrc は .gitignore で除外される（コミット禁止）

# ===== MCP サーバ用シークレット（.claude/mcp.json から参照） =====
export TAVILY_API_KEY="tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
export EXA_API_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export FIGMA_API_KEY="YOUR_FIGMA_API_KEY"

# ===== mobile-mcp（Android MCP サーバ） =====
# export MOBILE_MCP_PATH="/path/to/mobile-mcp/lib/index.js"
# export ANDROID_HOME="/path/to/Android/sdk"

# ===== GitHub（必要なら） =====
# export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ===== WordPress staging SSH（task db:sync 用） =====
# export STAGING_SSH_HOST="your-user@sv-XXXXX.xserver.jp"
# export STAGING_JP_DB_USER="xxxxxxxx"
# export STAGING_JP_DB_PASS="xxxxxxxx"
# export STAGING_EN_DB_USER="xxxxxxxx"
# export STAGING_EN_DB_PASS="xxxxxxxx"
