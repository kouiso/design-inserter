# ============================================================
# .claudeignore — Claude Codeのコンテキストから除外するファイル
# ============================================================

# ----------------------------------------
# WordPress コア（変更しない・巨大）
# ----------------------------------------
wp-admin/
wp-includes/
wp-activate.php
wp-blog-header.php
wp-comments-post.php
wp-cron.php
wp-links-opml.php
wp-load.php
wp-login.php
wp-mail.php
wp-settings.php
wp-signup.php
wp-trackback.php
xmlrpc.php
index.php
license.txt
readme.html

# セキュリティ上の理由でDB認証情報を含むファイルを除外
wp-config.php
wp-config-sample.php

# ----------------------------------------
# WordPress コンテンツ — システム領域
# ----------------------------------------
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backups/
wp-content/ai1wm-backups/
wp-content/wpvividbackups/
wp-content/wpvivid_staging/
wp-content/wpvivid_uploads/
wp-content/siteguard/
wp-content/languages/
wp-content/index.php
wp-content/themes/index.php

# ----------------------------------------
# サードパーティプラグイン（カスタム以外）
# ----------------------------------------
wp-content/plugins/
!wp-content/plugins/musashi-inquiry-approval/

# ----------------------------------------
# デフォルトテーマ（不使用）
# ----------------------------------------
wp-content/themes/twentytwenty/
wp-content/themes/twentytwentyone/
wp-content/themes/twentytwentytwo/
wp-content/themes/twentytwentythree/
wp-content/themes/twentytwentyfour/
wp-content/themes/twentytwentyfive/

# ----------------------------------------
# バイナリ（画像・フォント）
# ----------------------------------------
**/assets/img/
**/assets/fonts/

# ----------------------------------------
# Node.js
# ----------------------------------------
node_modules/

# ----------------------------------------
# テスト出力・スクリーンショット
# ----------------------------------------
test-results/
playwright-report/
test/screenshots/
test/vrt/screenshots/
test/vrt/report.html
/.playwright-mcp/

# ----------------------------------------
# ビルドキャッシュ・一時ファイル
# ----------------------------------------
.sass-cache/
.tmp/
tmpclaude-*/
wp-cli.phar
nul

# ----------------------------------------
# ログ
# ----------------------------------------
*.log
wp-content/debug.log

# ----------------------------------------
# 環境設定（認証情報含む）
# ----------------------------------------
.env.docker
local-xdebuginfo.php

# ----------------------------------------
# システムファイル
# ----------------------------------------
.DS_Store
Thumbs.db
.idea/
