# WordPress core downloaded into Docker volume or local root.
wp-admin/
wp-includes/
wp-config.php
wp-*.php
!tests/wp-stubs.php
xmlrpc.php
license.txt
readme.html
.htaccess

# WordPress runtime content.
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/backups/
wp-content/languages/
wp-content/mu-plugins/

# Track only this plugin and the minimal dev theme.
wp-content/plugins/*
!wp-content/plugins/index.php
!wp-content/plugins/designinserter/
!wp-content/plugins/designinserter/**
wp-content/themes/*
!wp-content/themes/index.php
!wp-content/themes/designinserter-dev/
!wp-content/themes/designinserter-dev/**

# Local environment.
.env
.env.docker
*.log
.DS_Store
Thumbs.db

# Node.
node_modules/
npm-debug.log*

# Test/build artifacts.
dist/
test-results/
playwright-report/
.playwright-mcp/
.tmp/
