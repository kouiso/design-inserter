<?xml version="1.0"?>
<ruleset name="DesignInserter">
	<description>Design Inserter PHP coding standard for plugin source and tests.</description>

	<file>wp-content/plugins/designinserter</file>
	<file>tests/php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/data/css-stock-parts.json</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="tab-width" value="4"/>

	<rule ref="Generic.PHP.Syntax"/>
	<rule ref="Generic.Files.ByteOrderMark"/>
	<rule ref="Generic.Files.LineEndings"/>
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="true"/>
		</properties>
	</rule>
	<rule ref="Squiz.PHP.DisallowMultipleAssignments"/>
	<rule ref="Squiz.PHP.DisallowSizeFunctionsInLoops"/>
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>
</ruleset>
