{
  "name": "wordpress-plugin-designinserter",
  "version": "0.2.0",
  "private": true,
  "description": "Local WordPress plugin development environment for Design Inserter.",
  "scripts": {
    "test": "node script/test.mjs",
    "build": "node script/build-plugin-zip.mjs",
    "build:zip": "node script/build-plugin-zip.mjs",
    "build:dev": "node script/build-plugin-zip.mjs --allow-locked-catalog",
    "e2e:fresh": "playwright test tests/e2e/fresh-install-222.spec.mjs --reporter=list",
    "e2e:template-party": "playwright test tests/e2e/template-party.spec.mjs --reporter=list",
    "ready:checklist": "node script/generate-ready-checklist.mjs",
    "scrape:css-stock": "node script/scrape-css-stock.mjs",
    "scrape:template-party": "node script/scrape-template-party.mjs",
    "scrape:template-party:meta": "node script/scrape-template-party.mjs --skip-zips",
    "scrape:template-party:parts": "node script/scrape-template-party-parts.mjs",
    "test:php": "docker run --rm -v \"$PWD\":/app -w /app composer:2 php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "phpcs": "docker run --rm -v \"$PWD\":/app -w /app composer:2 php vendor/bin/phpcs --standard=phpcs.xml.dist",
    "wp": "docker compose exec -T wordpress wp --allow-root",
    "php:lint": "find wp-content/plugins/designinserter wp-content/themes/designinserter-dev tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "php:lint:docker": "docker compose exec -T wordpress php -l wp-content/plugins/designinserter/designinserter.php",
    "smoke:wp": "node script/wp-smoke.mjs",
    "smoke:wp:docker": "node script/wp-smoke.mjs --docker",
    "smoke:wp:portable": "node script/wp-smoke.mjs --portable",
    "smoke:wp:stubs": "node script/wp-smoke.mjs --stubs"
  },
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "acorn": "^8.18.0"
  }
}
