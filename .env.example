# =============================================================================
# Docker ローカル開発環境 設定ファイル
# =============================================================================
# 使い方:
#   1. このファイルを .env にコピー
#   2. ポート番号やステージングDB認証情報を必要に応じて上書き
#   3. task init または docker compose up -d で起動
# =============================================================================

# === MySQL ===
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_DATABASE=musashi_jp

# === WordPress JP ===
JP_DB_NAME=musashi_jp
_DOCKER_COMPOSE_SITE_URL_WP_JP=http://localhost:8080
JP_WP_HOME=http://localhost:8080
JP_WP_TITLE=武蔵塗料 (Docker Dev)
JP_WP_LOCALE=ja
JP_WP_THEME=muashi
JP_WP_ADMIN_USER=admin
JP_WP_ADMIN_PASS=admin
JP_WP_ADMIN_EMAIL=admin@example.com

# === WordPress EN ===
EN_DB_NAME=musashi_en
_DOCKER_COMPOSE_SITE_URL_WP_EN=http://localhost:8081
EN_WP_HOME=http://localhost:8081
EN_WP_TITLE=MusashiPaint EN (Docker Dev)
EN_WP_LOCALE=en_US
EN_WP_THEME=muashi-en
EN_WP_ADMIN_USER=admin
EN_WP_ADMIN_PASS=admin
EN_WP_ADMIN_EMAIL=admin@example.com

# === WordPress Bogo + Bedrock ===
BOGO_DB_NAME=musashi_bogo
_DOCKER_COMPOSE_SITE_URL_WP_BOGO=http://localhost:8082
BOGO_WP_HOME=http://localhost:8082
BOGO_WP_TITLE=MusashiPaint Bogo
BOGO_WP_LOCALE=ja
BOGO_WP_THEME=muashi-bogo
BOGO_WP_ADMIN_USER=admin
BOGO_WP_ADMIN_PASS=admin
BOGO_WP_ADMIN_EMAIL=admin@example.com
BOGO_WP_PLUGINS=advanced-custom-fields bogo contact-form-7 contact-form-7-honeypot duplicate-post redirection wp-multibyte-patch wordpress-seo

# === プラグイン（スペース区切り） ===
# mu-pluginがMailpit SMTPを設定するため、wp-mail-smtpは含めない
WP_PLUGINS=advanced-custom-fields contact-form-7 contact-form-7-honeypot duplicate-post redirection wp-multibyte-patch wordpress-seo

# === SMTP (Mailpit) ===
SMTP_HOST=musashi-mail
SMTP_PORT=1025

# === ポート（ホスト側） ===
_DOCKER_COMPOSE_HOST_PORT_WP_JP=8080
_DOCKER_COMPOSE_HOST_PORT_WP_EN=8081
_DOCKER_COMPOSE_HOST_PORT_WP_BOGO=8082
_DOCKER_COMPOSE_HOST_PORT_DB=3316
_DOCKER_COMPOSE_HOST_PORT_MAILPIT_UI=8025
_DOCKER_COMPOSE_HOST_PORT_MAILPIT_SMTP=1025
WP_JP_PORT=8080
WP_EN_PORT=8081
WP_BOGO_PORT=8082
MYSQL_PORT=3316
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# === BrowserSync ===
_DOCKER_COMPOSE_BROWSERSYNC_PROXY=http://localhost:8080
BROWSERSYNC_PROXY=http://localhost:8080

# === ステージング DB同期用 (JP) ===
# task init は JP 同期を必須で実行します
STAGING_SSH_HOST=musashi
STAGING_JP_DB_USER=your_staging_db_user
STAGING_JP_DB_PASS=your_staging_db_pass
STAGING_JP_DB_NAME=your_staging_db_name
STAGING_JP_URL=https://musashipaint.xsrv.jp

# === ステージング DB同期用 (EN) ===
# EN は未設定なら task init 時に自動スキップされます
# パスワードに $ を含む場合は $$ として記述してください
STAGING_EN_DB_USER=
STAGING_EN_DB_PASS=
STAGING_EN_DB_NAME=
STAGING_EN_URL=https://musashipaint.xsrv.jp/en/