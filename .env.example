# Docker local WordPress plugin development settings.

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_PORT=3316

WORDPRESS_DB_NAME=designinserter
WP_PORT=8080
WP_HOME=http://localhost:8080
WP_TITLE=Design Inserter Dev
WP_LOCALE=ja
WP_THEME=designinserter-dev
WP_AUTO_INSTALL=false

WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin
WP_ADMIN_EMAIL=admin@example.com

# Space-separated wordpress.org plugin slugs to auto-install after WordPress is installed.
WP_PLUGINS=
